# Copy this file to .env.local for local development:  cp .env.example .env.local
#
# The values below are the DEFAULT local Supabase dev credentials produced by
# `supabase start` (well-known demo keys — safe for local dev only, never prod).
# If `supabase start` prints different keys on your machine, use `supabase status`
# and paste the ANON_KEY / SERVICE_ROLE_KEY here.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (REQUIRED — the app fails fast at startup without these) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Server-only, bypasses RLS — used by onboarding + chat/voice handlers.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Comma-separated allowlist for the operator-only onboarding tool.
OPERATOR_EMAILS=owner@coolbreeze.test

# --- Optional / lazy services (only needed when exercising those features) ---
# Anthropic (chat + voice AI replies)
# ANTHROPIC_API_KEY=sk-ant-...
# VOICE_CLAUDE_MODEL=

# Twilio (voice webhooks + number provisioning). Set to "false" locally to skip
# X-Twilio-Signature validation on simulated webhook POSTs.
TWILIO_VALIDATE_SIGNATURE=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Stripe (billing / checkout / webhooks)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_SETUP_FEE=price_...
# STRIPE_PRICE_SUBSCRIPTION=price_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Shared secret guarding the cron endpoints (expire-grace, digest).
# CRON_SECRET=
# BILLING_GRACE_PERIOD_DAYS=7
